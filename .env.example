# Copy to .env.local for development. Never commit real values.
# Business details, email recipients/sender, the Resend API key and Cloudinary
# credentials are NOT set here: they're managed in the admin (secrets encrypted).

# Postgres / Neon. Leave unset locally to use the embedded PGlite database in .data/.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Public origin (no trailing slash). Production: https://hotrockhove.com
APP_URL=http://localhost:3000

# 32+ random characters:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=
# 32 bytes, base64 or hex — encrypts admin-managed credentials. Back it up: losing it means re-entering keys.
SETTINGS_ENCRYPTION_KEY=

# Cloudflare Turnstile (recommended). Without it, forms rely on honeypot + rate limits and the dashboard warns.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional fallback if no Resend key is saved in Admin -> Email.
# RESEND_API_KEY=

# Vercel Cron authentication for /api/cron/retention (set in Vercel; Vercel sends it automatically).
# CRON_SECRET=

# Development only: store media on local disk (.data/media) instead of Cloudinary. Refused on Vercel.
ALLOW_LOCAL_STORAGE=false

# Optional: set to true to send the CSP as report-only while troubleshooting.
# CSP_REPORT_ONLY=false
